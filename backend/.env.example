# SafeHer Backend Environment Variables
# Copy this file to .env and fill in your actual values

PORT=5000
BACKEND_URL=http://localhost:5000
FIRESTORE_PREFER_REST=true

# Gemini AI API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Credentials (get from https://www.twilio.com/console)
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API Key (get from https://console.cloud.google.com/apis/credentials)
# Required for: Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Blockchain Configuration (Polygon Mumbai Testnet)
# Get testnet MATIC from: https://faucet.polygon.technology/
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
EVIDENCE_VAULT_CONTRACT=your_deployed_contract_address
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here
