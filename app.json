{
  "expo": {
    "name": "SafeHer",
    "slug": "safeher-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safehernative",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow SafeHer to recognize emergency voice triggers.",
        "NSMicrophoneUsageDescription": "Allow SafeHer to access your microphone for SOS audio evidence and emergency sound triggers."
      }
    },
    "android": {
      "package": "com.safeher.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCqWdL_SlUKLfnA9MJkPpFiTJB_hSDiPF0"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SafeHer to use your location to share with your trusted contacts during an emergency."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SafeHer to access your camera to record video evidence during an SOS."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SafeHer to access your microphone for SOS audio evidence and emergency sound triggers."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow SafeHer to access your microphone for SOS audio evidence and emergency sound triggers.",
          "speechRecognitionPermission": "Allow SafeHer to recognize emergency voice triggers.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f0575c0-c463-42f8-b771-ec88453896b0"
      }
    },
    "owner": "cartik98"
  }
}
